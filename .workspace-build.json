{
  "id": "grudgegit/grudge-dev-tool",
  "repository": "Grudge-Warlords/grudge-dev-tool",
  "group": "grudgegit",
  "name": "grudge-dev-tool",
  "source": "C:\\grudgegit\\grudge-dev-tool",
  "buildRoot": "D:\\grudgegit\\grudge-dev-tool",
  "outputRoot": "E:\\grudgegit\\grudge-dev-tool",
  "components": [
    {
      "id": "app",
      "label": "app",
      "relative": ".",
      "output": "app",
      "kind": "electron",
      "buildScript": "build",
      "launchScript": null,
      "installer": true,
      "requires": [
        "Node.js",
        "Electron builder",
        "NSIS"
      ],
      "notes": [],
      "electronConfig": null,
      "preCommands": [],
      "launchOptionOnBuildCompletion": true,
      "installerPolicy": {
        "type": "nsis-assisted",
        "oneClick": false,
        "runAfterFinish": true,
        "launchText": "Launch the program"
      }
    },
    {
      "id": "cli",
      "label": "cli",
      "relative": "cli",
      "output": "cli",
      "kind": "node",
      "buildScript": "build",
      "launchScript": null,
      "installer": false,
      "requires": [
        "Node.js and project package manager"
      ],
      "notes": [
        "No production start script is defined; opens completed package."
      ],
      "launchOptionOnBuildCompletion": true
    },
    {
      "id": "deploy-observatory",
      "label": "deploy/observatory",
      "relative": "deploy/observatory",
      "output": "deploy/observatory",
      "kind": "worker",
      "buildScript": null,
      "launchScript": null,
      "installer": false,
      "requires": [
        "Node.js and Wrangler"
      ],
      "notes": [
        "Bundles with wrangler deploy --dry-run; launcher uses local wrangler dev. No remote deployment."
      ],
      "launchOptionOnBuildCompletion": true
    }
  ],
  "packages": {
    ".": {
      "scripts": {
        "dev": "concurrently -k -n vite,tsc,app \"npm:dev:renderer\" \"npm:dev:tsc\" \"npm:dev:electron\"",
        "dev:renderer": "vite",
        "dev:tsc": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
        "dev:electron": "wait-on tcp:5173 && electron .",
        "dev:main": "npm run dev:tsc",
        "build:icons": "node scripts/build-icons.mjs",
        "prebuild": "npm run build:icons",
        "build": "npm run build:renderer && npm run build:main",
        "build:renderer": "vite build",
        "build:main": "tsc -p tsconfig.main.json && npm run build:preload",
        "build:preload": "node scripts/build-preload.mjs && npm run test:preload",
        "package": "npm run build && electron-builder --win nsis",
        "package:ci": "npm run build && electron-builder --win nsis --publish never",
        "package:dir": "npm run build && electron-builder --dir",
        "smoke:packaged": "node scripts/smoke-packaged.mjs",
        "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
        "test:preload": "node scripts/test-preload-bundle.mjs",
        "test:magic": "node scripts/test-magic-bytes.mjs",
        "test:prompt3d": "tsx scripts/test-prompt3d.ts",
        "test:prompt3d-provider-cache": "tsx scripts/test-prompt3d-provider-digest-cache.ts",
        "test:prompt3d-storage": "tsx scripts/test-prompt3d-storage-preflight.ts",
        "test:local-creation": "tsx scripts/test-local-creation.ts",
        "test:prompt3d-approval": "tsx scripts/test-prompt3d-concept-approval.ts",
        "test:prompt3d-reference": "tsx scripts/test-prompt3d-reference-image.ts",
        "test:prompt3d-provider-reference": "python scripts/test-provider-worker-reference-images.py",
        "test:prompt3d-rejected-refinement": "tsx scripts/test-prompt3d-rejected-refinement.ts",
        "test:prompt3d-prompt-rules": "tsx scripts/test-prompt3d-approval.ts",
        "test:prompt3d-concept-canvas": "python scripts/test-provider-worker-canvas.py",
        "test:prompt3d-batch-approvals": "tsx scripts/test-prompt3d-batch-approvals.ts",
        "test:prompt3d-batch-acceptance": "tsx scripts/test-prompt3d-batch-acceptance.ts",
        "test:prompt3d-workflow": "tsx scripts/test-prompt3d-workflow.ts",
        "test:prompt3d-paint-merge": "tsx scripts/test-prompt3d-paint-merge.ts",
        "test:prompt3d-visual-inspection": "tsx scripts/test-prompt3d-visual-inspection.ts",
        "test:prompt3d-renderer-recovery": "tsx scripts/test-prompt3d-renderer-recovery.ts",
        "test:prompt3d-artifacts": "tsx scripts/test-prompt3d-artifact-verification.ts",
        "test:prompted-animation": "tsx scripts/test-prompted-animation.ts",
        "test:deformation-regions": "tsx scripts/test-deformation-region-editor.ts",
        "test:hy-motion-rig": "tsx scripts/test-hy-motion-rig.ts",
        "test:deterministic-rig": "tsx scripts/test-deterministic-rig.ts",
        "test:prompt3d-orchestrator": "tsx scripts/test-prompt3d-orchestrator.ts",
        "test:prompt-motion-trail": "tsx scripts/test-prompt-motion-trail.ts",
        "test:forge-animation": "tsx scripts/test-forge-animation.ts",
        "test:viewport-navigation": "tsx scripts/test-viewport-navigation.ts",
        "test:guided-reliability": "tsx scripts/test-guided-reliability.ts && node scripts/test-updater-guards.mjs",
        "test:prompt3d-sidecar": "tsx scripts/test-prompt3d-sidecar.ts",
        "doctor": "tsx cli/src/cli.ts doctor",
        "doctor:json": "tsx cli/src/cli.ts doctor --json --no-write",
        "fleet:probe": "tsx scripts/fleet-probe.mjs",
        "backup:postgres": "node scripts/backup-postgres.mjs",
        "backup:postgres:list": "node scripts/backup-postgres.mjs --list-tables",
        "restore:postgres": "node scripts/restore-postgres.mjs",
        "restore:postgres:docker": "node scripts/restore-postgres.mjs --docker",
        "audit:workers": "node scripts/audit-workers-config.mjs",
        "catalog:ummorpg": "node scripts/catalog-ummorpg.mjs",
        "maintenance:check": "node scripts/maintenance/daily-maintenance.mjs --check",
        "maintenance:daily": "node scripts/maintenance/daily-maintenance.mjs",
        "maintenance:scheduled": "node scripts/maintenance/daily-maintenance.mjs --scheduled --json",
        "maintenance:test": "node --test scripts/maintenance/maintenance.test.mjs",
        "ci:local": "npm run typecheck && npm run build:preload && npm run maintenance:test && npm run maintenance:check",
        "ci:live": "npm run doctor:json && npm run fleet:probe",
        "ci": "npm run ci:local && npm run ci:live",
        "rebuild:native": "npx @electron/rebuild -f -w keytar,sharp",
        "upload-pack": "tsx scripts/upload-asset-pack.ts",
        "secret:import": "node scripts/import-secrets.mjs",
        "secret:set": "node scripts/set-secret.mjs",
        "secret:verify": "node scripts/verify-creds.mjs",
        "secret:session": "node scripts/verify-session-admin.mjs",
        "verify:stack": "npm run secret:verify && npm run secret:session && npm run doctor && npm run fleet:probe",
        "toolchain:install": "node scripts/install-toolchain.mjs",
        "toolchain:probe": "node scripts/probe-toolchain.mjs",
        "prompt3d:install": "tsx scripts/prompt3d-install.ts",
        "prompt3d:smoke": "tsx scripts/prompt3d-smoke.ts",
        "publish:manual": "node scripts/publish-manual.mjs --bump patch",
        "publish:manual:minor": "node scripts/publish-manual.mjs --bump minor",
        "publish:manual:major": "node scripts/publish-manual.mjs --bump major",
        "publish:manual:dry": "node scripts/publish-manual.mjs --bump patch --dry-run"
      },
      "packageManager": "npm@10.9.2",
      "name": "grudge-dev-tool"
    },
    "cli": {
      "scripts": {
        "build": "tsc",
        "dev": "tsx src/cli.ts",
        "prepublishOnly": "npm run build",
        "doctor": "node dist/cli.js doctor",
        "setup": "node dist/cli.js setup"
      },
      "packageManager": null,
      "name": "grudge-dev-tool"
    },
    "templates/r3f-boilerplate": {
      "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "tsc --noEmit"
      },
      "packageManager": null,
      "name": "grudge-r3f-app"
    }
  },
  "nativeEntries": [],
  "preexistingTrackedChanges": [],
  "releaseOnly": false,
  "storageProfile": ".storage/profile.json",
  "storageDevice": ".storage/device.json"
}
