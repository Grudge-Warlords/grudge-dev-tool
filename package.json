{
  "name": "grudge-dev-tool",
  "version": "1.0.8",
  "description": "Grudge Dev Tool 1.0.7 — Simple video viewer, AI asset cards, stream open, media SSOT.",
  "private": true,
  "homepage": "https://grudge-warlords.github.io/grudge-dev-tool/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Grudge-Warlords/grudge-dev-tool.git"
  },
  "bugs": {
    "url": "https://github.com/Grudge-Warlords/grudge-dev-tool/issues"
  },
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2",
  "author": {
    "name": "Racalvin The Pirate King",
    "email": "games@grudgestudio.org"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k -n vite,tsc,app \"npm:dev:renderer\" \"npm:dev:tsc\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:tsc": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "dev:main": "npm run dev:tsc",
    "build:icons": "node scripts/build-icons.mjs",
    "prebuild": "npm run build:icons",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "package": "npm run build && electron-builder --win nsis",
    "package:ci": "npm run build && electron-builder --win nsis --publish never",
    "package:dir": "npm run build && electron-builder --dir",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test:magic": "node scripts/test-magic-bytes.mjs",
    "doctor": "tsx cli/src/cli.ts doctor",
    "doctor:json": "tsx cli/src/cli.ts doctor --json",
    "fleet:probe": "tsx scripts/fleet-probe.mjs",
    "backup:postgres": "node scripts/backup-postgres.mjs",
    "backup:postgres:list": "node scripts/backup-postgres.mjs --list-tables",
    "audit:workers": "node scripts/audit-workers-config.mjs",
    "catalog:ummorpg": "node scripts/catalog-ummorpg.mjs",
    "ci": "npm run typecheck && npm run doctor:json && npm run fleet:probe",
    "rebuild:native": "npx @electron/rebuild -f -w keytar,sharp",
    "upload-pack": "tsx scripts/upload-asset-pack.ts",
    "secret:import": "node scripts/import-secrets.mjs",
    "secret:set": "node scripts/set-secret.mjs",
    "secret:verify": "node scripts/verify-creds.mjs",
    "secret:session": "node scripts/verify-session-admin.mjs",
    "verify:stack": "npm run secret:verify && npm run secret:session && npm run doctor && npm run fleet:probe",
    "toolchain:install": "node scripts/install-toolchain.mjs",
    "toolchain:probe": "node scripts/probe-toolchain.mjs",
    "publish:manual": "node scripts/publish-manual.mjs --bump patch",
    "publish:manual:minor": "node scripts/publish-manual.mjs --bump minor",
    "publish:manual:major": "node scripts/publish-manual.mjs --bump major",
    "publish:manual:dry": "node scripts/publish-manual.mjs --bump patch --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "@aws-sdk/s3-request-presigner": "^3.658.1",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@heyputer/puter.js": "^2.2.15",
    "@tanstack/react-query": "^5.51.1",
    "ag-psd": "^31.0.2",
    "electron-log": "^5.1.7",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.2.1",
    "fflate": "^0.8.2",
    "keytar": "^7.9.0",
    "lucide-react": "^0.408.0",
    "meshoptimizer": "^0.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "sonner": "^1.5.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.51.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "pg": "^8.22.0",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.7.0",
    "vite": "^8.0.10",
    "wait-on": "^7.2.0"
  }
}
