+    object.userData?.editorGizmo || object.userData?.measureLine ||
+    object.userData?.lightHelper || object.type === 'BoxHelper'
+  );
+}
+
+export function removeSavedEditorHelpers(scene: THREE.Scene): void {
+  const helpers: THREE.Object3D[] = [];
+  scene.traverse(object => { if (isRuntimeEditorHelper(object)) helpers.push(object); });
+  for (const helper of helpers) helper.removeFromParent();
+}
+
+/** Serialize without mutating or disposing the live scene's shared resources. */
+export function serializeEditorScene(scene: THREE.Scene) {
+  // A save can run before the next render has composed recently edited transforms.
+  scene.updateMatrixWorld(true);
+  const excluded = new Set<string>();
+  scene.traverse(object => {
+    if (isRuntimeEditorHelper(object) || object.parent === scene && (object as THREE.Camera).isCamera) {
+      excluded.add(object.uuid);
+    }
+  });
+  const json = scene.toJSON();
+  const strip = (value: unknown): void => {
+    if (!value || typeof value !== 'object') return;
+    const object = value as { children?: unknown };
+    if (!Array.isArray(object.children)) return;
+    const children = object.children.filter((child: unknown) => {
+      const uuid = typeof child === 'string' ? child : child && typeof child === 'object' && 'uuid' in child ? child.uuid : null;
+      return typeof uuid !== 'string' || !excluded.has(uuid);
+    });
+    object.children = children;
+    children.forEach(strip);
+  };
+  strip(json.object);
+  return json;
+}
