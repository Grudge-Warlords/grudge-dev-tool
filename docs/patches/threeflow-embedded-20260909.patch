@@ -0,0 +1,49 @@
+<template>
+  <div v-if="open" class="tf-palette" role="dialog" aria-modal="true" aria-label="Command palette" @click.self="close">
+    <section class="tf-palette-card">
+      <div class="tf-palette-head">
+        <input ref="input" v-model="query" aria-label="Search commands" placeholder="Command… (Esc)" />
+        <button type="button" aria-label="Close command palette" @click="close">Close</button>
+      </div>
+      <button v-for="command in matches" :key="command.id" type="button" class="tf-command" @click="run(command)">
+        <span>{{ command.label }}</span><small>{{ command.keys || command.group }}</small>
+      </button>
+      <p v-if="!matches.length" role="status">No matching commands</p>
+    </section>
+  </div>
+</template>
+<script setup lang="ts">
+import { computed, nextTick, onMounted, onUnmounted, ref } from 'vue';
+import { ElMessage } from 'element-plus';
+import { editorCommands, type EditorCommand } from '@/utils/editorShell';
+import { sceneEventBus } from '@/utils/globalProperties';
+import { MITT_ON_KEY } from '@/enums/enum';
+
+const open = ref(false), query = ref(''), input = ref<HTMLInputElement | null>(null);
+const matches = computed(() => editorCommands.value.filter(command => `${command.label} ${command.group}`.toLowerCase().includes(query.value.toLowerCase())));
+const close = () => { open.value = false; };
+const show = async (value = true) => {
+  open.value = value;
+  if (value) { query.value = ''; await nextTick(); input.value?.focus(); }
+};
+const run = async (command: EditorCommand) => {
+  close();
+  try { await command.run(); }
+  catch (error) { ElMessage.error(error instanceof Error ? error.message : 'Command did not complete'); }
+};
+const keydown = (event: KeyboardEvent) => {
+  if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); void show(!open.value); }
+  else if (event.key === 'Escape' && open.value) { event.preventDefault(); close(); }
+};
+onMounted(() => { sceneEventBus.on(MITT_ON_KEY.OPEN_PALETTE, show); window.addEventListener('keydown', keydown); });
+onUnmounted(() => { sceneEventBus.off(MITT_ON_KEY.OPEN_PALETTE, show); window.removeEventListener('keydown', keydown); });
+</script>
+<style scoped>
+.tf-palette { position: fixed; inset: 0; z-index: 2000; background: #0009; display: flex; justify-content: center; align-items: flex-start; padding-top: 10vh; }
+.tf-palette-card { width: min(520px, 90vw); max-height: 75vh; overflow: auto; background: #11141d; border: 1px solid #6f6030; color: #eee; padding: 10px; }
+.tf-palette-head { display: flex; gap: 8px; margin-bottom: 8px; }
+.tf-palette-head input { min-width: 0; flex: 1; background: #1c2130; color: #eee; padding: 8px; border: 1px solid #777; }
+.tf-palette-head button, .tf-command { background: #1c2130; color: #eee; border: 1px solid #454a58; padding: 8px; cursor: pointer; }
+.tf-command { display: flex; width: 100%; justify-content: space-between; margin-top: 4px; }
+.tf-command:hover, .tf-command:focus-visible { background: #554820; }
+</style>
diff --git a/scripts/test-scene-snapshot.mjs b/scripts/test-scene-snapshot.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/test-scene-snapshot.mjs
@@ -0,0 +1,30 @@
+import assert from 'node:assert/strict';
+import * as THREE from 'three';
+import { serializeEditorScene, removeSavedEditorHelpers } from '../src/utils/sceneSnapshot.ts';
+
+const scene = new THREE.Scene();
+const box = new THREE.Mesh(new THREE.BoxGeometry(), new THREE.MeshStandardMaterial());
+box.name = 'Restore Check'; box.position.set(3, 1, -1.52);
+const particles = new THREE.Points(new THREE.BufferGeometry(), new THREE.PointsMaterial());
+particles.name = 'Authored particles';
+const line = new THREE.Line(new THREE.BufferGeometry(), new THREE.LineBasicMaterial());
+line.userData.measureLine = true;
+const gizmo = new THREE.Object3D(); gizmo.userData.editorGizmo = true;
+scene.add(box, particles, line, gizmo, new THREE.PerspectiveCamera());
+let disposed = false;
+box.geometry.addEventListener('dispose', () => { disposed = true; });
+box.material.addEventListener('dispose', () => { disposed = true; });
+let snapshot = serializeEditorScene(scene);
+for (let i = 0; i < 3; i++) {
+  const restored = await new THREE.ObjectLoader().parseAsync(snapshot);
+  assert.equal(restored.children.length, 2, 'Only authored mesh and particles survive each round trip');
+  assert.deepEqual(restored.getObjectByName('Restore Check').position.toArray(), [3, 1, -1.52]);
+  assert.equal(restored.getObjectByName('Authored particles').isPoints, true);
+  snapshot = serializeEditorScene(restored);
+}
+assert.equal(disposed, false, 'Saving never disposes live resources');
+assert.equal(scene.children.length, 5, 'Saving never mutates the editor graph');
+removeSavedEditorHelpers(scene);
+assert.equal(scene.children.length, 3, 'Legacy saved measurement and gizmo helpers are removed');
+assert.equal(scene.getObjectByName('Authored particles'), particles);
+console.log('PASS repeated scene round trips preserve authored objects and transforms without helper accumulation or live resource disposal');
